{
  "name": "voice-of-jesus-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "prepare": "husky install",
    "dev": "next dev",
    "build": "npm run package:nexus && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "package:nexus": "node scripts/package-nexus.mjs",
    "text:stats": "node scripts/text-stats.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^4.9.0",
    "framer-motion": "^14.10.1",
    "next": "16.4.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/plugin-kit": "^0.7.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "levn": "^0.4.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0"
  }
}
