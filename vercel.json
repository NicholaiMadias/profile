{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run check",
  "redirects": [
    {
      "source": "/arcade/word-sprint",
      "destination": "/arcade/code-matrix#typing-challenge",
      "permanent": false
    },
    {
      "source": "/arcade/quick-click",
      "destination": "/arcade/relay-protocol#quick-click",
      "permanent": false
    },
    {
      "source": "/arcade/vim-defender",
      "destination": "/arcade/relay-protocol",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
