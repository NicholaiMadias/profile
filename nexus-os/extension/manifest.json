{
  "manifest_version": 3,
  "name": "Nexus OS Preview",
  "version": "0.1.0",
  "description": "Send reviewed prompts and selected text to your Nexus OS backend.",
  "action": { "default_popup": "index.html", "default_title": "Nexus OS" },
  "permissions": ["activeTab", "scripting"],
  "optional_host_permissions": ["https://*.run.app/*", "http://127.0.0.1/*"]
}
