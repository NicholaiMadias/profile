rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    function hasOptionalShortString(data, field, maxLen) {
      return !data.keys().hasAny([field]) || (data[field] is string && data[field].size() <= maxLen);
    }

    function hasOptionalTimestamp(data, field) {
      return !data.keys().hasAny([field]) || data[field] is timestamp;
    }

    function hasOptionalList(data, field, maxLen) {
      return !data.keys().hasAny([field]) || (data[field] is list && data[field].size() <= maxLen);
    }

    function validPostShape(data) {
      return data.keys().hasOnly([
        'authorUid',
        'title',
        'body',
        'excerpt',
        'tags',
        'coverImageUrl',
        'published',
        'createdAt',
        'updatedAt'
      ])
      && data.keys().hasAll([
        'authorUid',
        'title',
        'body',
        'published',
        'createdAt',
        'updatedAt'
      ])
      && isShortString(data.authorUid, 128)
      && isShortString(data.title, 180)
      && isShortString(data.body, 20000)
      && data.published is bool
      && data.createdAt is timestamp
      && data.updatedAt is timestamp
      && hasOptionalShortString(data, 'excerpt', 500)
      && hasOptionalShortString(data, 'coverImageUrl', 2048)
      && hasOptionalList(data, 'tags', 25);
    }

    // Allow public read access to blog posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.authorUid == request.auth.uid
                    && validPostShape(request.resource.data)
                    && request.resource.data.authorUid == resource.data.authorUid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt >= resource.data.updatedAt;

      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // User-specific data access rules
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
