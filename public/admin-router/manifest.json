{
  "manifest_version": 3,
  "name": "Drive and Docs Router Test",
  "version": "1.0.0",
  "permissions": ["webNavigation"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://drive.google.com/*", "https://docs.google.com/*"], "js": ["content-main.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://drive.google.com/*", "https://docs.google.com/*"], "js": ["spa-router.js", "example.js"], "run_at": "document_start", "world": "ISOLATED" }
  ]
}
